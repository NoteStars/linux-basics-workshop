Vagrant.configure("2") do |config|

  # Use openSUSE Tumbleweed
  config.vm.box = "opensuse/Tumbleweed.x86_64"
  config.vm.hostname = "opensuse-workshop"

  # SSH configuration
  config.vm.network "forwarded_port",
    guest: 22,
    host: 2203,
    host_ip: "127.0.0.1",
    id: "ssh",
    auto_correct: true

  # Boot and SSH timeouts
  config.vm.boot_timeout = 300
  config.ssh.connect_timeout = 30

  # Configure VirtualBox resources
  config.vm.provider "virtualbox" do |vb|
    vb.name = "Linux-Basics-openSUSE"
    vb.memory = 2048
    vb.cpus = 2
  end

  # Configure private network
  config.vm.network "private_network", type: "dhcp"

  # Install workshop packages
  config.vm.provision "shell", inline: <<-SHELL
    set -e

    echo "Refreshing openSUSE repositories..."
    zypper --non-interactive refresh

    echo "Updating openSUSE Tumbleweed..."
    zypper --non-interactive dup

    echo "Installing workshop packages..."
    zypper --non-interactive install --no-recommends \
      git curl wget tree htop nano vim sudo

    echo "openSUSE Tumbleweed workshop environment ready!"
  SHELL

end
